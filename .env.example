# ------------------------------------------------------------
# Fonteva Payments 3.0 AI Upgrade Assistant — environment config
# ------------------------------------------------------------

# Which LLM to use for agent reasoning + Copilot chat.
#   "mock"    -> deterministic fallback (no API calls, works offline)
#   "openai"  -> real OpenAI-compatible provider (default when OPENAI_API_KEY is set)
LLM_PROVIDER=openai

# Company-provided GPT-4o Mini API key. When set, all agents stream real
# reasoning through this provider AND the Copilot chatbot uses it too.
# Leave empty to fall back to the deterministic MockLLM.
OPENAI_API_KEY=

# Model name. GPT-4o Mini works great for reasoning + summarization.
OPENAI_MODEL=gpt-4o-mini

# Optional. Point this at a company proxy if your endpoint isn't
# https://api.openai.com/v1. The adapter will call `${OPENAI_BASE_URL}/chat/completions`.
# OPENAI_BASE_URL=https://api.openai.com/v1
